{
  "name": "@stevenleep/data-grid",
  "version": "0.2.0",
  "description": "A protocol-driven data grid with a headless core and an Ant Design 6 renderer for React admin applications.",
  "keywords": [
    "react",
    "antd",
    "admin",
    "data-grid",
    "table",
    "headless",
    "protocol-driven",
    "typescript"
  ],
  "homepage": "https://github.com/stevenleep/data-grid#readme",
  "bugs": {
    "url": "https://github.com/stevenleep/data-grid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenleep/data-grid.git"
  },
  "author": {
    "name": "ivan",
    "email": "ivan@voidjs.dev",
    "url": "https://github.com/stevenleep"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "files": [
    "dist",
    "docs",
    "etc/api",
    "style.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./antd": {
      "import": {
        "types": "./dist/antd.d.mts",
        "default": "./dist/antd.mjs"
      },
      "require": {
        "types": "./dist/antd.d.cts",
        "default": "./dist/antd.cjs"
      }
    },
    "./style.css": {
      "types": "./style.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown && node scripts/clean-style-artifacts.mjs",
    "dev": "tsdown --watch",
    "demo": "pnpm --filter @stevenleep/data-grid-demo dev",
    "demo:build": "pnpm --filter @stevenleep/data-grid-demo build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "api:check": "pnpm build && node scripts/api-report.mjs",
    "api:check:built": "node scripts/api-report.mjs",
    "api:report": "pnpm build && node scripts/api-report.mjs --local",
    "quality:check": "pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "check": "pnpm quality:check && pnpm build && pnpm demo:build",
    "package:inspect": "pnpm build && pnpm package:inspect:built",
    "package:inspect:built": "pnpm api:check:built && pnpm pack:check && pnpm publint && pnpm attw",
    "package:check": "pnpm build && pnpm package:inspect:built && pnpm consumer:smoke:all",
    "release:check": "pnpm quality:check && pnpm build && pnpm demo:build && pnpm package:inspect:built && pnpm consumer:smoke:all",
    "prepublishOnly": "pnpm release:check",
    "pack:check": "pnpm pack --dry-run",
    "publint": "publint",
    "attw": "attw --pack . --profile node16 --entrypoints . core react antd",
    "consumer:smoke": "node scripts/package-smoke.mjs",
    "consumer:smoke:core": "pnpm consumer:smoke -- --profile=core-min && pnpm consumer:smoke -- --profile=core-current",
    "consumer:smoke:minimum": "pnpm consumer:smoke -- --profile=react18-min && pnpm consumer:smoke -- --profile=react19-min",
    "consumer:smoke:current": "pnpm consumer:smoke -- --profile=react18-current && pnpm consumer:smoke -- --profile=react19-current --with-vite",
    "consumer:smoke:npm": "pnpm consumer:smoke -- --profile=core-min --manager=npm && pnpm consumer:smoke -- --profile=react19-current --with-vite --manager=npm",
    "consumer:smoke:browser": "pnpm consumer:smoke -- --profile=react19-current --with-vite --with-browser",
    "consumer:smoke:all": "pnpm consumer:smoke:core && pnpm consumer:smoke:minimum && pnpm consumer:smoke:current && pnpm consumer:smoke:npm && pnpm consumer:smoke:browser"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=6.0.0 <7.0.0",
    "antd": ">=6.0.0 <7.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.59.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.0",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "antd": "^6.6.1",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "publint": "0.3.24",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "typescript-current": "npm:typescript@7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
